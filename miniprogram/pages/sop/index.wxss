/* ===== 目录页 ===== */
.sop-page .title { font-size:56rpx;white-space:nowrap; }
.intro { margin-bottom:32rpx;font-size:28rpx;color:var(--ink-2);font-weight:500; }

/* 五类等宽分段条 */
.category-bar { width:100%;margin-bottom:24rpx; }
.categories { display:flex;align-items:center;width:100%;background:var(--select);border-radius:var(--radius-pill);padding:8rpx;gap:8rpx; }
.category { flex:1;padding:20rpx 0;font-size:28rpx;border:0;background:transparent;border-radius:var(--radius-pill);white-space:nowrap;color:var(--ink-2);font-weight:500;text-align:center;min-height:88rpx;display:flex;align-items:center;justify-content:center; }
.category.selected { background:var(--ink);color:var(--bg);font-weight:500; }

/* 共 N 条 + 搜索入口 */
.case-count-line { display:flex;align-items:center;justify-content:space-between;margin:8rpx 0 0;min-height:48rpx;font-size:24rpx;color:var(--ink-3); }
.search-entry { width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center; }
.search-icon { width:28rpx;height:28rpx;border:2rpx solid var(--ink-3);border-radius:50%;position:relative; }
.search-icon::after { content:'';position:absolute;right:-6rpx;bottom:-6rpx;width:10rpx;height:2rpx;background:var(--ink-3);transform:rotate(45deg); }

/* 空状态 */
.case-empty { padding:80rpx 0;text-align:center;font-size:28rpx;color:var(--ink-2);font-weight:500; }

/* 案例列表：纯文字行，不做卡片 */
.case-list { display:flex;flex-direction:column; }
.case-row { display:flex;align-items:center;gap:24rpx;padding:32rpx 0;border-bottom:1px solid var(--line); }
.case-main { flex:1;min-width:0; }
.case-name { font-family:var(--font-title);font-size:36rpx;line-height:1.35;font-weight:600;color:var(--ink);margin-bottom:8rpx;display:block; }
.case-new { margin-right:12rpx;font-family:var(--font-body);font-size:24rpx;color:var(--accent);font-weight:500;line-height:1; }
.case-task { display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:28rpx;font-weight:500;color:var(--ink-2);line-height:1.5; }
.case-meta { display:flex;align-items:center;flex-wrap:wrap;gap:16rpx;margin-top:12rpx; }
.case-count { font-size:24rpx;color:var(--ink-3); }
.case-read { font-size:24rpx;color:var(--ink-2); }
.case-side { flex-shrink:0;display:flex;align-items:center; }
.case-arrow { display:block;width:16rpx;height:16rpx;border-right:2rpx solid var(--ink-3);border-top:2rpx solid var(--ink-3);transform:rotate(45deg); }
.case-continue { background:var(--ink);color:var(--bg);font-size:24rpx;font-weight:500;min-height:88rpx;height:88rpx;padding:0 24rpx;border-radius:var(--radius-pill); }
.case-continue::after { border:0; }

.footer-links { padding:40rpx 0 8rpx;display:flex;justify-content:center; }
.footer-link { background:transparent;border:0;min-height:88rpx;padding:0 16rpx;font-size:24rpx;color:var(--ink-3); }
.footer-link::after { border:0; }

/* 隐私弹窗 */
.privacy-mask { position:fixed;inset:0;background:var(--ink);opacity:.25;z-index:30; }
.privacy-sheet { position:fixed;top:0;right:0;bottom:0;width:90%;background:var(--bg);z-index:31;padding:32rpx;display:flex;flex-direction:column;border-left:1px solid var(--line);animation:privacy-in .18s ease-out; }
@keyframes privacy-in { from { transform:translateX(100%); } to { transform:translateX(0); } }
.privacy-heading { display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx; }
.privacy-scroll { flex:1;height:0; }
.privacy-block { padding:24rpx 0;border-bottom:1px solid var(--line); }
.privacy-h { font-size:28rpx;color:var(--ink);margin-bottom:12rpx;font-weight:600; }
.privacy-p { font-size:28rpx;color:var(--ink-2);line-height:1.7;font-weight:500; }

/* ===== 案例详情页 ===== */
.detail-heading { display:flex;align-items:center;gap:16rpx;margin-bottom:16rpx; }
.back { padding-left:0;flex-shrink:0; }
.detail-name { font-family:var(--font-title);font-size:30rpx;font-weight:600;overflow:hidden;white-space:nowrap;text-overflow:ellipsis; }

.video-modes { display:flex;gap:8rpx;margin-bottom:16rpx;background:var(--select);border-radius:var(--radius-small);padding:4rpx; }
.video-modes button { flex:1;border:0;border-radius:var(--radius-small);font-size:26rpx;font-weight:500;min-height:88rpx;color:var(--ink-2); }
.video-modes button.selected[disabled] { background:var(--bg);color:var(--ink);font-weight:600;opacity:1; }

.reference-video,.media-empty { width:100%;height:42vh;max-height:560rpx;border-radius:var(--radius-small);background:var(--video-bg); }
.media-empty { color:var(--bg);display:flex;align-items:center;justify-content:center;padding:32rpx; }

/* 镜头导航条 */
.shot-heading { margin:24rpx 0; }
.shot-count { margin-top:24rpx; }
.current-shot { font-size:24rpx;color:var(--ink-3);font-weight:500; }
.shot-title { font-family:var(--font-title);font-size:36rpx;line-height:var(--line-title);color:var(--ink);font-weight:600; }
.lesson-reason { margin-bottom:24rpx;padding:24rpx 0;border-bottom:1px solid var(--line); }
.shot-reason { margin-top:24rpx; }
.shot-nav { display:flex;gap:16rpx;margin:24rpx 0; }
.nav-btn { flex:1;padding:16rpx 8rpx;font-size:26rpx;border:1px solid var(--line);border-radius:var(--radius-pill);min-height:88rpx;color:var(--ink);font-weight:500; }
.nav-btn::after { border:0; }
.nav-btn[disabled] { color:var(--ink-3);border-color:var(--line); }
.nav-btn.primary-btn { background:var(--ink);color:var(--bg);border:0; }
.nav-btn.primary-btn[disabled] { background:var(--select);color:var(--ink-3); }

/* 六项信息逐项呈现 */
.instructions { margin-top:8rpx; }
.step { padding:32rpx 0;border-bottom:1px solid var(--line); }
.step-last { border-bottom:0; }
.step-label { display:flex;align-items:center;gap:16rpx;color:var(--ink-3);font-size:24rpx;font-weight:500;margin-bottom:16rpx; }
.step-body { font-size:30rpx;color:var(--ink);line-height:1.65;font-weight:500; }
.quote { font-family:var(--font-title);border-left:2px solid var(--ink);padding-left:24rpx; }
.check-icon { display:inline-block;width:18rpx;height:28rpx;border-right:2px solid var(--ink-2);border-bottom:2px solid var(--ink-2);transform:rotate(40deg);margin:0 8rpx 8rpx; }

/* 底部吸附主操作 */
.detail-page { padding-bottom:calc(200rpx + var(--tabbar-height) + env(safe-area-inset-bottom)); }
.sop-action { position:fixed;bottom:calc(var(--tabbar-height) + env(safe-area-inset-bottom));left:0;right:0;padding:16rpx 40rpx 16rpx;background:var(--bg);border-top:1px solid var(--line);z-index:5; }
.sop-action button { width:100%;font-size:26rpx;font-weight:600;min-height:88rpx;border-radius:var(--radius-pill); }


/* 将橙红集中到列表前两行，避免长列表满屏强调。 */
.case-row:nth-child(-n+2) .case-read { color:var(--accent); }
.case-row:nth-child(n+3) .case-new { display:none; }
.search-box { display:flex;align-items:center;gap:16rpx;border-bottom:1px solid var(--line);margin-bottom:8rpx; }
.search-box input { flex:1;min-width:0;height:88rpx;font-size:28rpx;color:var(--ink); }
@media (prefers-reduced-motion:reduce) { .privacy-sheet { animation:none; } }
