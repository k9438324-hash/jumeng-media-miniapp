<view class="page sop-page {{lesson ? 'detail-page' : ''}}">
 <view class="brand-heading"><brand-menu items="{{menuItems}}" bind:command="menuCommand" /><button class="teacher-entry" bindtap="openTeacher">老师后台</button></view>
 <view wx:if="{{courseNotice}}" class="notice warning">{{courseNotice}}</view>
 <block wx:if="{{!lesson}}">
  <view class="title">对标 SOP</view>
  <view class="muted intro">选一种现场，照着参考片拍</view>

  <view class="category-bar">
   <view class="categories">
    <view wx:for="{{categories}}" wx:key="id" class="category {{categoryId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCategory" role="button" aria-label="{{item.name}}">{{item.name}}</view>
   </view>
  </view>

  <view class="case-count-line"><text>共 {{caseCount}} 条</text><view wx:if="{{showSearch}}" class="search-entry" bindtap="toggleSearch" role="button" aria-label="搜索"><text class="search-icon"></text></view></view>

  <view wx:if="{{showSearch && searchOpen}}" class="search-box"><input value="{{searchQuery}}" bindinput="search" placeholder="搜索案例名称或拍摄内容" maxlength="80" aria-label="搜索案例" /><button class="text-button" bindtap="toggleSearch">收起</button></view>

  <view wx:if="{{caseCount === 0}}" class="case-empty">这一类还没有案例</view>

  <view wx:elif="{{!visibleCases.length}}" class="case-empty">没有找到相关案例</view>
  <view wx:else class="case-list">
   <view wx:for="{{visibleCases}}" wx:key="id" class="case-row" data-id="{{item.id}}" bindtap="openCase" role="button" aria-label="{{item.name}}">
    <view class="case-main">
     <view class="case-name"><text wx:if="{{item.isNew}}" class="case-new">新</text>{{item.name}}</view>
     <view class="case-task">{{item.displayTask}}</view>
     <view class="case-meta">
      <text class="case-count">{{item.shots.length}} 个镜头</text>
      <text wx:if="{{item.hasProgress}}" class="case-read">读到第 {{item.readShotIndex + 1}} 镜</text>
     </view>
    </view>
    <view class="case-side">
     <button wx:if="{{item.hasProgress}}" class="case-continue" data-id="{{item.id}}" catchtap="openCase">继续</button>
     <text wx:else class="case-arrow"></text>
    </view>
   </view>
  </view>

  <view class="footer-links"><button class="footer-link" bindtap="showPrivacy">隐私说明</button></view>
 </block>

 <block wx:else>
  <view class="detail-heading"><button class="text-button back" bindtap="back" aria-label="返回目录">‹ 返回</button><text class="detail-name">{{lesson.name}}</text></view>
  <view class="lesson-reason"><view class="step-label">这条视频要说清楚什么</view><view class="step-body">{{lesson.takeaway}}</view></view>

  <view class="video-modes"><button class="{{!full ? 'selected' : ''}}" bindtap="toggleFull" disabled="{{!full}}">当前参考片段</button><button class="{{full ? 'selected' : ''}}" bindtap="toggleFull" disabled="{{full}}">完整原片</button></view>

  <video wx:if="{{videoSrc}}" id="reference" class="reference-video" src="{{videoSrc}}" poster="{{poster}}" initial-time="{{initialTime}}" object-fit="contain" autoplay="{{false}}" controls bindtimeupdate="timeUpdate" binderror="videoError" />
  <view wx:else class="media-empty muted">参考视频暂未配置，拍摄步骤仍可阅读。</view>
  <view wx:if="{{mediaError}}" class="notice">视频暂时无法播放<button class="text-button" bindtap="replay">重新加载</button></view>

  <view class="shot-heading">
   <view class="shot-title">{{shot.title}}</view>
   <view wx:if="{{shot.logic}}" class="shot-reason"><view class="step-label">为什么这样拍</view><view class="step-body">{{shot.logic}}</view></view>
   <view class="shot-count"><text class="current-shot">参考镜头 {{shotIndex + 1}} / {{lesson.shots.length}}</text></view>
  </view>

  <view class="shot-nav">
   <button class="nav-btn" bindtap="previous" disabled="{{shotIndex === 0}}">上一镜</button>
   <button class="nav-btn" bindtap="replay" disabled="{{!videoSrc}}">重播</button>
   <button class="nav-btn primary-btn" bindtap="next" disabled="{{shotIndex === lesson.shots.length - 1}}">下一镜</button>
  </view>

  <view class="instructions">
   <view class="step"><view class="step-label">站在哪里</view><view class="step-body">{{shot.where}}</view></view>
   <view class="step"><view class="step-label">手机对准哪里</view><view class="step-body">{{shot.frame}}</view></view>
   <view class="step"><view class="step-label">开始后做什么</view><view class="step-body">{{shot.action}}</view></view>
   <view class="step"><view class="step-label">IP说什么或问什么</view><view class="step-body quote">{{shot.say}}</view></view>
   <view class="step"><view class="step-label">什么时候停止</view><view class="step-body">{{shot.stop}}</view></view>
   <view class="step step-last"><view class="step-label"><text class="check-icon"></text>拍够的标准</view><view class="step-body">{{shot.check}}</view></view>
  </view>

  <view class="sop-action"><button class="primary" bindtap="bringToAI">带入聚梦AI，按现场调整拍法</button></view>
 </block>

 <view wx:if="{{privacyOpen}}" class="privacy-mask" bindtap="closePrivacy" aria-label="关闭隐私说明"></view>
 <view wx:if="{{privacyOpen}}" class="privacy-sheet" role="dialog" aria-label="隐私说明">
  <view class="privacy-heading"><view class="subtitle">隐私说明</view><button class="text-button" bindtap="closePrivacy">关闭</button></view>
  <scroll-view scroll-y class="privacy-scroll">
   <view class="privacy-block"><view class="privacy-h">我们收集的信息</view><view class="privacy-p">当你使用「聚梦传媒」小程序时，我们会收集：微信身份标识（用于识别你的学习记录与权限）、你主动输入的文字内容、阅读进度等学习数据。我们不会收集与你使用本服务无关的个人信息。</view></view>
   <view class="privacy-block"><view class="privacy-h">信息的使用</view><view class="privacy-p">上述信息仅用于：为你提供课程学习记录、AI 拍摄建议、学习进度同步等核心功能。你的输入内容会发送至 AI 服务以生成回复。</view></view>
   <view class="privacy-block"><view class="privacy-h">AI 生成内容说明</view><view class="privacy-p">本小程序的「聚梦AI」功能由人工智能模型生成内容。AI 生成的内容仅供参考，不构成专业意见，请结合现场实际情况核对后使用。</view></view>
   <view class="privacy-block"><view class="privacy-h">信息的存储与保护</view><view class="privacy-p">我们采用行业通行的安全措施保护你的信息，未经你的授权不会向第三方披露你的个人信息，法律法规另有规定的除外。</view></view>
   <view class="privacy-block"><view class="privacy-h">联系我们</view><view class="privacy-p">如你对本隐私说明或个人信息保护有任何疑问，可通过课程提供方与我们联系。</view></view>
  </scroll-view>
 </view>
</view>
