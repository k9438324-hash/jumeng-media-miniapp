.teacher-page { padding-bottom:calc(64rpx + env(safe-area-inset-bottom)); }
.teacher-heading { display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;min-height:88rpx; }
.teacher-logo { width:72rpx;height:72rpx; }
.teacher-page button { width:100%;margin:0; }
.teacher-heading .text-button { width:auto; }
.password-box { border-bottom:1px solid var(--ink);margin:64rpx 0 32rpx;padding:16rpx 0; }
.password-box input { height:88rpx;font-size:36rpx;letter-spacing:8rpx; }
.enter { width:100%;border-radius:var(--radius-pill); }
.sections { display:flex;align-items:center;gap:8rpx;margin:24rpx 0 32rpx;border-bottom:1px solid var(--line); }
.sections button { width:auto;flex:1;font-size:28rpx;padding:16rpx 12rpx;white-space:nowrap; }
.sections .selected { border-bottom:3rpx solid var(--ink);border-radius:0;font-weight:600; }
.teacher-page .list-row { display:flex;justify-content:space-between;gap:24rpx;width:100%;padding:32rpx 0;text-align:left;border-bottom:1px solid var(--line);border-radius:0; }
.list-row > view { flex:1;min-width:0; }
.item-title { font-family:var(--font-title);font-size:34rpx;margin-bottom:8rpx; }
.field { margin:24rpx 0; }
.field input,.field textarea,.picker-value { width:100%;min-height:88rpx;padding:16rpx 20rpx;margin-top:12rpx;border:1px solid var(--line);border-radius:var(--radius-small);background:var(--surface);font-size:28rpx;line-height:1.6; }
.field textarea { min-height:112rpx; }
.outline { border:1px solid var(--line);font-size:26rpx; }
.back-list { justify-content:flex-start;padding-left:0; }
.shot-editor { border-top:1px solid var(--line);margin:24rpx 0; }
.shot-toggle { width:100%;justify-content:space-between;padding:24rpx 0;text-align:left;font-size:30rpx; }
.shot-toggle text { font-size:24rpx;color:var(--ink-2);flex-shrink:0;margin-left:16rpx; }
.media-actions,.save-actions { display:flex;gap:16rpx;margin:24rpx 0; }
.media-actions button,.save-actions button { flex:1;min-width:0;padding:16rpx 8rpx; }
.usage { border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:24rpx 0 40rpx;padding:16rpx 0; }
.usage view { display:flex;justify-content:space-between;padding:12rpx 0;font-size:28rpx; }
.usage text { font-weight:600; }
.records-title { margin:40rpx 0 24rpx; }
.record { border-bottom:1px solid var(--line);padding:20rpx 0; }
.empty { padding:48rpx 0; }
.success { margin-top:24rpx;padding:24rpx 0;border-top:1px solid var(--line);color:var(--ink-2);font-size:28rpx; }
.notice { margin-top:24rpx; }
