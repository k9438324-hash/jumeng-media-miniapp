.ai-page { height:100vh;display:flex;flex-direction:column;overflow:hidden; }

/* ===== 顶栏 ===== */
.ai-top { padding:24rpx 32rpx 0;flex-shrink:0; }
.ai-heading { display:flex;align-items:center;justify-content:space-between;gap:8rpx; }
.ai-title { font-family:var(--font-title);font-size:44rpx;line-height:1.25;font-weight:300;white-space:nowrap;flex-shrink:0;letter-spacing:1rpx; }
.header-actions { display:flex;align-items:center;gap:0;margin-left:auto;flex-shrink:0; }
.header-btn { display:flex;align-items:center;gap:4rpx;min-height:88rpx;height:88rpx;padding:0 10rpx;background:transparent;border:0;border-radius:8rpx;font-size:26rpx;color:var(--ink-2);white-space:nowrap;line-height:1; }
.header-btn::after { border:0; }
.header-btn[disabled] { color:var(--ink-3);opacity:.5; }
.header-icon { display:inline-block;width:24rpx;height:24rpx;position:relative;flex-shrink:0; }
/* 细线加号图标 */
.header-icon.plus::before { content:'';position:absolute;left:3rpx;right:3rpx;top:11rpx;height:2rpx;background:currentColor; }
.header-icon.plus::after { content:'';position:absolute;top:3rpx;bottom:3rpx;left:11rpx;width:2rpx;background:currentColor; }
/* 细线时钟图标 */
.header-icon.clock { border:2rpx solid currentColor;border-radius:50%;box-sizing:border-box; }
.header-icon.clock::before { content:'';position:absolute;left:10rpx;top:5rpx;width:2rpx;height:7rpx;background:currentColor; }
.header-icon.clock::after { content:'';position:absolute;left:10rpx;top:11rpx;width:5rpx;height:2rpx;background:currentColor; }

/* ===== 状态行 ===== */
.mode-row { display:flex;align-items:center;gap:12rpx;min-height:48rpx;margin:8rpx 0 16rpx;flex-wrap:nowrap;overflow:hidden; }
.mode-label { font-size:26rpx;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.mode-real { font-size:26rpx;color:var(--ink-3); }

/* ===== 登录过期紧凑提示条 ===== */
.auth-notice { display:flex;align-items:center;gap:16rpx;height:72rpx;padding:0 24rpx 0 20rpx;background:var(--select);border-radius:8rpx;margin-bottom:16rpx; }
.auth-bar { width:4rpx;height:32rpx;background:var(--warn);border-radius:2rpx;flex-shrink:0; }
.auth-text { font-size:26rpx;color:var(--warn);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.auth-retry { flex-shrink:0;min-height:72rpx;padding:0 8rpx;background:transparent;border:0;font-size:26rpx;color:var(--warn);font-weight:600; }
.auth-retry::after { border:0; }

/* ===== 上下文条 ===== */
.context { border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:16rpx 0; }
.context-row { display:flex;align-items:center;justify-content:space-between;gap:16rpx; }
.context-title { font-size:26rpx;color:var(--ink-2);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;min-width:0; }
.context-clear { flex-shrink:0;min-height:88rpx;padding:0;background:transparent;border:0;font-size:26rpx;color:var(--ink-3); }
.context-clear::after { border:0; }

/* ===== 消息区 ===== */
.message-scroll { flex:1;height:0;min-height:0; }
.messages { padding:24rpx 32rpx calc(320rpx + env(safe-area-inset-bottom)); }
.message { margin:24rpx 0 48rpx; }
.message.user { margin-left:64rpx;background:var(--select);padding:24rpx;border-radius:16rpx; }
.message.assistant { margin-right:16rpx;background:transparent;padding:0; }
.message-text { display:block;white-space:pre-wrap;line-height:1.7;word-break:break-all; }
.message.assistant .message-text { font-size:30rpx; }
.message-label { color:var(--ink-3);font-size:22rpx;margin-bottom:12rpx;letter-spacing:4rpx;display:flex;align-items:center;gap:12rpx; }
.ai-badge { font-size:20rpx;color:var(--ink-3);letter-spacing:1rpx;padding:2rpx 12rpx;border:1px solid var(--line);border-radius:999rpx;line-height:1.5; }
.message-actions { display:flex;gap:32rpx;margin-top:16rpx; }
.message-action { background:transparent;border:0;padding:8rpx 0;min-height:88rpx;font-size:26rpx;color:var(--ink-2); }
.message-action::after { border:0; }
.generation-state { display:flex;align-items:center;gap:16rpx;color:var(--ink-3);font-size:26rpx;min-height:48rpx; }
.generation-state.active { color:var(--accent); }
.status-dot { width:8rpx;height:8rpx;border-radius:999rpx;background:var(--accent); }
.messages-end { height:16rpx; }

/* ===== 空状态 ===== */
.empty { display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120rpx 48rpx; }
.empty-mark { width:96rpx;height:96rpx;display:block;margin-bottom:48rpx;border-radius:24rpx; }
.empty-title { font-family:var(--font-title);font-size:48rpx;line-height:1.25;margin-bottom:16rpx;color:var(--ink);font-weight:300;letter-spacing:2rpx; }
.empty-desc { font-size:26rpx;line-height:1.65;color:var(--ink-2);max-width:480rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden; }

/* ===== 输入区 ===== */
.composer { position:fixed;left:0;right:0;background:var(--bg);padding:16rpx 32rpx 16rpx;border-top:1px solid var(--line);z-index:5; }
.examples-scroll { width:100%; }
.examples { display:inline-flex;gap:16rpx;padding:8rpx 32rpx 16rpx;white-space:nowrap; }
.example-pill { flex-shrink:0;display:flex;align-items:center;height:64rpx;padding:0 24rpx;border:1px solid var(--line);border-radius:999rpx;background:var(--surface);font-size:26rpx;color:var(--ink);white-space:nowrap;line-height:1; }
.example-pill::after { border:0; }
.example-pill[disabled] { opacity:.5;color:var(--ink-3); }
.composer-box { display:flex;align-items:flex-end;gap:16rpx;background:var(--surface);border:1px solid var(--line);border-radius:16rpx;padding:16rpx; }
.composer-input { flex:1;min-width:0;min-height:48rpx;max-height:264rpx;padding:8rpx 0;background:transparent;font-size:30rpx;line-height:1.65; }
.input-placeholder { color:var(--ink-3); }
.send-btn { flex-shrink:0;width:80rpx;height:80rpx;box-sizing:border-box;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center; }
.send-btn.disabled { background:var(--select);opacity:.6; }
.send-icon { display:block;width:28rpx;height:28rpx;position:relative; }
/* 白色箭头图标 */
.arrow-icon::before { content:'';position:absolute;left:6rpx;top:8rpx;width:16rpx;height:16rpx;border-right:3rpx solid #FFFFFF;border-top:3rpx solid #FFFFFF;transform:rotate(45deg); }
.arrow-icon::after { content:'';position:absolute;left:4rpx;top:7rpx;width:20rpx;height:3rpx;background:#FFFFFF;transform:rotate(45deg);transform-origin:left center; }
/* 停止方块图标 */
.stop-icon::before { content:'';position:absolute;left:6rpx;top:6rpx;width:16rpx;height:16rpx;background:#FFFFFF;border-radius:3rpx; }
.composer-hint { font-size:24rpx;color:var(--ink-3);text-align:center;margin-top:8rpx; }

/* ===== 历史 ===== */
.history-mask { position:fixed;inset:0;background:var(--ink);opacity:.25;z-index:20; }
.history-sheet { position:fixed;top:0;right:0;bottom:0;width:90%;background:var(--bg);z-index:21;padding:32rpx;display:flex;flex-direction:column;border-left:1px solid var(--line); }
.history-heading { display:flex;align-items:center;justify-content:space-between; }
.history-scroll { flex:1;height:0; }
.history-date { margin:32rpx 0 16rpx; }
.history-item { border:0;border-bottom:1px solid var(--line);border-radius:0;display:flex;justify-content:space-between;gap:16rpx;width:100%;padding:24rpx 0;text-align:left; }
.history-title { flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.history-sheet { animation:history-in .18s ease-out; }
@keyframes history-in { from { transform:translateX(100%); } to { transform:translateX(0); } }
