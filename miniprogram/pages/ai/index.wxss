.ai-page { height:100vh;display:flex;flex-direction:column;overflow:hidden; }

/* ===== 顶栏 ===== */
.ai-top { padding:24rpx 40rpx 0;flex-shrink:0; }
.ai-heading { display:flex;align-items:center;justify-content:space-between;gap:16rpx; }

/* ===== 模拟模式标签 ===== */
.mock-row { display:flex;align-items:center;min-height:48rpx;margin:8rpx 0 0; }

/* ===== 登录过期紧凑提示条 ===== */
.auth-notice { display:flex;align-items:center;gap:16rpx;min-height:72rpx;padding:0 24rpx 0 20rpx;background:var(--select);border-radius:8rpx;margin-top:12rpx; }
.auth-bar { width:4rpx;height:32rpx;background:var(--warn);border-radius:2rpx;flex-shrink:0; }
.auth-text { font-size:26rpx;color:var(--warn);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500; }
.auth-retry { flex-shrink:0;min-height:88rpx;padding:0 8rpx;background:transparent;border:0;font-size:26rpx;color:var(--warn);font-weight:600; }
.auth-retry::after { border:0; }

/* ===== 上下文条 ===== */
.context { border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:16rpx 0;margin-top:12rpx; }
.context-row { display:flex;align-items:center;justify-content:space-between;gap:16rpx; }
.context-title { font-size:26rpx;color:var(--ink-2);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;min-width:0;font-weight:500; }
.context-clear { flex-shrink:0;min-height:88rpx;padding:0;background:transparent;border:0;font-size:26rpx;color:var(--ink-3); }
.context-clear::after { border:0; }
.context-hint { font-size:24rpx;color:var(--ink-3);margin-top:4rpx; }

/* ===== 消息区 ===== */
.message-scroll { flex:1;height:0;min-height:0; }
.messages { padding:24rpx 40rpx calc(320rpx + env(safe-area-inset-bottom)); }
.message { margin:24rpx 0 48rpx; }
.message.user { margin-left:64rpx;background:var(--select);padding:24rpx;border-radius:16rpx; }
.message.assistant { margin-right:16rpx;background:transparent;padding:0; }
.message-text { display:block;white-space:pre-wrap;line-height:1.7;word-break:break-all;font-size:30rpx; }
.message-label { color:var(--ink-3);font-size:24rpx;margin-bottom:12rpx;font-weight:500; }
.message-foot { margin-top:16rpx; }
.message-hint { display:block;font-size:24rpx;color:var(--ink-3);margin-bottom:8rpx; }
.message-actions { display:flex;gap:32rpx; }
.message-action { background:transparent;border:0;padding:8rpx 0;min-height:88rpx;font-size:26rpx;color:var(--ink-2);font-weight:500; }
.message-action::after { border:0; }
.generation-state { display:flex;align-items:center;gap:16rpx;color:var(--ink-3);font-size:26rpx;min-height:48rpx; }
.generation-state.active { color:var(--ink-2); }
.status-dot { width:8rpx;height:8rpx;border-radius:999rpx;background:var(--ink-2); }
.messages-end { height:16rpx; }

/* ===== 空状态（上移到约上 1/3） ===== */
.empty { display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;padding:clamp(48rpx, 12vh, 160rpx) 24rpx 32rpx; }
.empty-mark { width:96rpx;height:96rpx;display:block;margin-bottom:48rpx; }
.empty-title { font-family:var(--font-title);font-size:44rpx;line-height:1.35;color:var(--ink);font-weight:600; }

/* ===== 输入区 ===== */
.composer { position:fixed;left:0;right:0;background:var(--bg);padding:16rpx var(--page-gutter);z-index:5; }
.examples { display:flex;flex-direction:column;padding:8rpx 0 16rpx; }
.example-line { height:88rpx;line-height:88rpx;font-size:28rpx;color:var(--ink-2);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.composer-box { display:flex;align-items:flex-end;gap:16rpx;background:var(--surface);border:3rpx solid var(--ink);border-radius:16rpx;padding:16rpx; }
.composer-input { flex:1;min-width:0;min-height:48rpx;max-height:214rpx;padding:8rpx 0;background:transparent;font-size:30rpx;line-height:1.65;font-weight:500; }
.input-placeholder { color:var(--ink-3); }
.send-btn { flex-shrink:0;width:88rpx;height:88rpx;box-sizing:border-box;border-radius:50%;background:var(--ink);display:flex;align-items:center;justify-content:center; }
.send-btn.disabled { opacity:.4; }
.send-icon { display:block;width:28rpx;height:28rpx;position:relative; }
/* 米白箭头图标 */
.arrow-icon::before { content:'';position:absolute;left:6rpx;top:2rpx;width:16rpx;height:16rpx;border-right:3rpx solid var(--button-text);border-top:3rpx solid var(--button-text);transform:rotate(-45deg); }
.arrow-icon::after { content:'';position:absolute;left:13rpx;top:4rpx;width:3rpx;height:24rpx;background:var(--button-text); }
/* 停止方块图标 */
.stop-icon::before { content:'';position:absolute;left:6rpx;top:6rpx;width:16rpx;height:16rpx;background:var(--button-text);border-radius:3rpx; }

/* ===== 历史 ===== */
.history-mask { position:fixed;inset:0;background:var(--ink);opacity:.25;z-index:20; }
.history-sheet { position:fixed;top:0;right:0;bottom:0;width:90%;background:var(--bg);z-index:21;padding:32rpx;display:flex;flex-direction:column;border-left:1px solid var(--line); }
.history-heading { display:flex;align-items:center;justify-content:space-between; }
.history-scroll { flex:1;height:0; }
.history-date { margin:32rpx 0 16rpx; }
.history-item { border:0;border-bottom:1px solid var(--line);border-radius:0;display:flex;justify-content:space-between;gap:16rpx;width:100%;padding:24rpx 0;text-align:left; }
.history-title { flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.history-sheet { padding-bottom:calc(32rpx + env(safe-area-inset-bottom));animation:history-in .18s ease-out; }
@keyframes history-in { from { transform:translateX(100%); } to { transform:translateX(0); } }

.network-notice { display:flex;align-items:center;gap:16rpx;font-size:26rpx;padding:0; }
.network-notice text { flex:1;min-width:0; }
.network-notice .text-button { flex-shrink:0; }
@media (max-width:350px) { .ai-top { padding-left:32rpx;padding-right:32rpx; }  }
@media (max-height:600px) { .empty { padding-top:32rpx; } .empty-mark { margin-bottom:24rpx; } }
@media (prefers-reduced-motion:reduce) { .history-sheet { animation:none; } }
