@import "../styles/tokens.wxss";
.tab-bar { position:fixed;left:0;right:0;bottom:0;display:flex;background:var(--bg);border-top:1px solid var(--line);padding:0 24rpx env(safe-area-inset-bottom);z-index:10; }
.tab-item { position:relative;flex:1;min-width:0;height:112rpx;display:flex;align-items:center;justify-content:center;padding-bottom:8rpx; }
.tab-text { color:var(--ink-2);font-family:var(--font-body);font-size:var(--size-nav);font-weight:400;line-height:1.4;white-space:nowrap; }
.tab-item.active .tab-text { color:var(--ink);font-weight:600; }
.tab-mark { position:absolute;bottom:18rpx;left:50%;transform:translateX(-50%);width:40rpx;height:3rpx;background:var(--ink);border-radius:var(--radius-pill);opacity:0; }
.tab-item.active .tab-mark { opacity:1; }
