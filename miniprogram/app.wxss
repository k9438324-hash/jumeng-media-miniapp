@import "styles/tokens.wxss";
page { --tabbar-height:112rpx; background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:var(--size-body);font-weight:500;line-height:1.65; }
view,text,button,textarea { box-sizing:border-box; }
text,view { overflow-wrap:anywhere;word-break:break-all; }
button { margin:0;padding:16rpx 24rpx;min-height:88rpx;border:0;border-radius:12rpx;background:transparent;color:var(--ink);font:inherit;line-height:1.65;font-weight:500;display:flex;align-items:center;justify-content:center; }
button::after { border:0; } button[disabled] { color:var(--ink-3);background:transparent;opacity:.65; }
button.primary { background:var(--ink);color:var(--button-text); }
button.primary[disabled] { background:var(--select);color:var(--ink-3); }
.page { padding:32rpx 40rpx;padding-bottom:calc(48rpx + var(--tabbar-height) + env(safe-area-inset-bottom)); }
.title { font-family:var(--font-title);font-size:52rpx;line-height:1.35;font-weight:600;margin:0 0 12rpx; }
.subtitle { font-size:36rpx;line-height:1.35;font-weight:500; }
.muted { color:var(--ink-2);font-size:28rpx;font-weight:500; }
.help { color:var(--ink-3);font-size:24rpx; }
.row { display:flex;align-items:center;gap:16rpx; }
.text-button { background:transparent;border:0;padding:8rpx 16rpx;font-size:26rpx;min-height:88rpx;color:var(--ink-2); }
.notice { border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:16rpx 0;font-size:28rpx;color:var(--danger); }
.notice.warning { color:var(--warn); }
.mode-tag { display:inline-flex;align-items:center;border:1px solid var(--warn);color:var(--warn);border-radius:8rpx;padding:0 12rpx;font-size:24rpx;font-weight:500; }
.skeleton { background:var(--select);border-radius:8rpx;height:24rpx;margin:24rpx 0; }
.skeleton.short { width:55%; }

.brand-heading { display:flex;align-items:center;min-height:88rpx;margin-bottom:24rpx; }
